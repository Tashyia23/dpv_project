# pages/5_🧪_Data_Lab.py
import streamlit as st
import numpy as np
import pandas as pd
import plotly.express as px

from utils.merged_datasets import load_master_dataset
from utils.ui import header

st.set_page_config(layout="wide")

# ---------------------------------------------------------
# LOAD MERGED DATASET (REAL-TIME PROCESSING)
# ---------------------------------------------------------
base_df = load_master_dataset()

header(
    "🧪 Data Lab – Dynamic Problem & Preprocessing",
    "Experiment with cleaning, normalisation, outlier filtering, and ask custom analytical questions."
)

if base_df is None or base_df.empty:
    st.error("Merged dataset could not be loaded.")
    st.stop()

# ---------------------------------------------------------
# 1. CLEANING & TRANSFORMATION UI
# ---------------------------------------------------------
st.markdown("<div class='chart-card'>", unsafe_allow_html=True)
st.markdown("### 1. Cleaning & Transformation Settings")

clean_col, info_col = st.columns([0.7, 0.3])

with clean_col:
    # Missing data strategy
    missing_strategy = st.radio(
        "Missing values handling",
        [
            "Leave as is (raw data)",
            "Drop rows with ANY missing value",
            "Fill numeric columns with mean",
            "Fill numeric columns with median",
        ],
    )

    numeric_cols = base_df.select_dtypes(include="number").columns.tolist()

    if not numeric_cols:
        st.error("No numeric columns were detected in the dataset.")
        st.stop()

    # Best default metric (priority order)
    priority_cols = [
        "pm25_aqi_value", "aqi_value", "pm10_aqi_value",
        "no2_aqi_value", "ozone_aqi_value", "co_aqi_value"
    ]
    default_metric = next((c for c in priority_cols if c in numeric_cols), numeric_cols[0])

    base_metric = st.selectbox(
        "Metric to focus on (for scaling, filtering & ranking)",
        numeric_cols,
        index=numeric_cols.index(default_metric)
    )

    # Normalisation options
    norm_choice = st.selectbox(
        "Normalisation (optional)",
        ["None", "Min–Max (0–1)", "Z-Score (mean 0, std 1)"]
    )

    # Outlier removal
    st.caption("Optional noise filtering (keep values within selected percentiles).")
    p_low, p_high = st.slider(
        "Percentile range of the selected metric",
        min_value=0,
        max_value=100,
        value=(0, 100),
        step=1,
    )

with info_col:
    st.markdown("#### Why this matters?")
    st.markdown("""
    - **Missing values** may distort statistical results  
    - **Normalisation** places all values on comparable scales  
    - **Percentile filtering** removes extreme outliers / noise  
    """)

# Make a copy for cleaning
df_clean = base_df.copy()

# ---------------------------------------------------------
# APPLY MISSING VALUE STRATEGY
# ---------------------------------------------------------
if missing_strategy == "Drop rows with ANY missing value":
    df_clean = df_clean.dropna()

elif missing_strategy == "Fill numeric columns with mean":
    for col in numeric_cols:
        df_clean[col] = df_clean[col].fillna(df_clean[col].mean())

elif missing_strategy == "Fill numeric columns with median":
    for col in numeric_cols:
        df_clean[col] = df_clean[col].fillna(df_clean[col].median())
# else: Raw data (no modification)

# ---------------------------------------------------------
# APPLY NORMALISATION
# ---------------------------------------------------------
active_metric_col = base_metric  # by default

if norm_choice == "Min–Max (0–1)":
    col = df_clean[base_metric].astype(float)
    if col.max() > col.min():
        df_clean[f"{base_metric}_scaled"] = (col - col.min()) / (col.max() - col.min())
        active_metric_col = f"{base_metric}_scaled"

elif norm_choice == "Z-Score (mean 0, std 1)":
    col = df_clean[base_metric].astype(float)
    if col.std() > 0:
        df_clean[f"{base_metric}_z"] = (col - col.mean()) / col.std()
        active_metric_col = f"{base_metric}_z"

# ---------------------------------------------------------
# OUTLIER FILTER BASED ON PERCENTILE RANGE
# ---------------------------------------------------------
if p_low > 0 or p_high < 100:
    q_low = np.percentile(df_clean[base_metric].dropna(), p_low)
    q_high = np.percentile(df_clean[base_metric].dropna(), p_high)
    df_clean = df_clean[(df_clean[base_metric] >= q_low) & (df_clean[base_metric] <= q_high)]

st.markdown("</div>", unsafe_allow_html=True)

# ---------------------------------------------------------
# DOWNLOAD CLEANED DATASET
# ---------------------------------------------------------
st.download_button(
    "⬇️ Download cleaned dataset (CSV)",
    df_clean.to_csv(index=False).encode("utf-8"),
    file_name="cleaned_master_dataset.csv",
    mime="text/csv"
)

# ---------------------------------------------------------
# 2. CUSTOM USER ANALYSIS
# ---------------------------------------------------------
st.markdown("<div class='chart-card'>", unsafe_allow_html=True)
st.markdown("### 2. Ask Your Custom Question")

q_col1, q_col2, q_col3 = st.columns(3)

# Country filter
with q_col1:
    if "country" in df_clean.columns:
        countries = sorted(df_clean["country"].unique())
        selected_countries = st.multiselect(
            "Filter by country (optional)",
            countries,
            default=countries[:5]
        )
    else:
        selected_countries = None

# AQI category filter (if available)
with q_col2:
    if "aqi_category" in df_clean.columns:
        categories = sorted(df_clean["aqi_category"].dropna().unique())
        selected_cats = st.multiselect(
            "AQI category filter",
            categories,
            default=categories
        )
    else:
        selected_cats = None

# Numeric filter for chosen metric
with q_col3:
    min_val, max_val = df_clean[base_metric].min(), df_clean[base_metric].max()
    val_low, val_high = st.slider(
        f"{base_metric}: Select value range",
        min_value=float(min_val),
        max_value=float(max_val),
        value=(float(min_val), float(max_val)),
        step=1.0,
    )

# Apply filters
df_q = df_clean.copy()
if selected_countries:
    df_q = df_q[df_q["country"].isin(selected_countries)]
if selected_cats:
    if "aqi_category" in df_q.columns:
        df_q = df_q[df_q["aqi_category"].isin(selected_cats)]
df_q = df_q[(df_q[base_metric] >= val_low) & (df_q[base_metric] <= val_high)]

# ---------------------------------------------------------
# SELECT ANALYSIS TYPE
# ---------------------------------------------------------
analysis_choice = st.radio(
    "Choose analysis",
    [
        "How many records match my filters?",
        "What is the average of the selected metric?",
        "Top N countries by the selected metric",
        "Compare selected metric across countries (bar chart)",
    ],
    label_visibility="collapsed",
)

# ---------------------------------------------------------
# EXECUTE ANALYSIS
# ---------------------------------------------------------
if df_q.empty:
    st.warning("No rows match your filters.")
else:
    if analysis_choice == "How many records match my filters?":
        st.metric("Matching rows", len(df_q))

    elif analysis_choice == "What is the average of the selected metric?":
        st.metric("Average value", f"{df_q[base_metric].mean():.2f}")

    elif analysis_choice == "Top N countries by the selected metric":
        if "country" not in df_q.columns:
            st.error("Country column missing.")
        else:
            n = st.slider("Top N", 3, 20, 10)
            rank = df_q.groupby("country")[base_metric].mean().nlargest(n).reset_index()
            st.dataframe(rank)

            fig = px.bar(
                rank,
                x="country",
                y=base_metric,
                color="country",
                title=f"Top {n} Countries by {base_metric}",
                color_discrete_sequence=px.colors.qualitative.Set2,
            )
            fig.update_layout(height=420)
            st.plotly_chart(fig, use_container_width=True)

    else:  # Comparison Bar Chart
        if "country" not in df_q.columns:
            st.error("Country column missing.")
        else:
            comp = df_q.groupby("country")[base_metric].mean().reset_index()

            fig = px.bar(
                comp,
                x="country",
                y=base_metric,
                color="country",
                title=f"{base_metric} Comparison Across Selected Countries",
                color_discrete_sequence=px.colors.qualitative.Set2,
            )
            fig.update_layout(height=420)
            st.plotly_chart(fig, use_container_width=True)

    # Show table
    with st.expander("🔍 View cleaned & filtered data"):
        st.dataframe(df_q)

st.markdown("</div>", unsafe_allow_html=True)

