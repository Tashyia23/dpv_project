
# pages/4_🔍_Country_Deep_Dive.py

import streamlit as st
import plotly.express as px
import numpy as np
import pandas as pd

from utils.merged_datasets import load_master_dataset
from utils.ui import header

st.set_page_config(layout="wide")

# ---------------------------------------------------------
# 1. Load merged dataset
# ---------------------------------------------------------
df = load_master_dataset()

header(
    "🔍 Country Deep Dive",
    "Single-country dashboard with AQI profile, pollutant mix, health category, and PM2.5 historical exposure trends."
)

if df is None or df.empty:
    st.error("Merged dataset could not be loaded.")
    st.stop()

# ---------------------------------------------------------
# 2. Auto-detect country column
# ---------------------------------------------------------
country_col = None
for c in ["country", "Country", "entity", "Entity"]:
    if c in df.columns:
        country_col = c
        break

if country_col is None:
    st.error("Dataset missing a country column.")
    st.stop()

df["country"] = df[country_col].astype(str)

# ---------------------------------------------------------
# 3. Auto-detect pollutant AQI columns
# ---------------------------------------------------------
pollutant_cols = [c for c in df.columns if c.endswith("_aqi_value")]

# ---------------------------------------------------------
# 4. Auto-detect PM2.5 historical column
# ---------------------------------------------------------
pm_candidates = ["pm25", "pm25_mean", "pm25_concentration", "PM2.5"]
pm25_col = next((c for c in pm_candidates if c in df.columns), None)

if pm25_col is None:
    st.warning("No PM2.5 historical column found in merged dataset.")
    st.stop()

# Auto-detect year column
year_col = None
for c in ["year", "Year", "YEAR"]:
    if c in df.columns:
        year_col = c
        break

if year_col is None:
    st.warning("Dataset contains no 'year' column for historical PM2.5 trend.")
    st.stop()

df[year_col] = pd.to_numeric(df[year_col], errors="coerce")
df = df.dropna(subset=[year_col])
df[year_col] = df[year_col].astype(int)

# ---------------------------------------------------------
# 5. Country selection
# ---------------------------------------------------------
countries = sorted(df["country"].unique())
selected_country = st.selectbox("Select a country", countries, key="deep_dive_country")

# ---------------------------------------------------------
# 6. AQI Category Function
# ---------------------------------------------------------
def classify_aqi(aqi: float) -> str:
    if aqi <= 50:
        return "Good"
    elif aqi <= 100:
        return "Moderate"
    elif aqi <= 150:
        return "Unhealthy for Sensitive Groups"
    elif aqi <= 200:
        return "Unhealthy"
    elif aqi <= 300:
        return "Very Unhealthy"
    else:
        return "Hazardous"

# ---------------------------------------------------------
# 7. Layout
# ---------------------------------------------------------
left, right = st.columns(2)

# ---------------------------------------------------------
# LEFT — CURRENT AIR QUALITY + POLLUTANT MIX
# ---------------------------------------------------------
with left:
    st.markdown("<div class='chart-card'>", unsafe_allow_html=True)
    st.markdown(f"### 🇺🇳 Current Air Quality — {selected_country}")

    df_now = df[df["country"] == selected_country]

    if df_now.empty:
        st.info("No AQI data found for this country.")
    else:
        # Overall AQI
        if "aqi_value" in df_now.columns:
            avg_aqi = df_now["aqi_value"].mean()
            st.metric("Average AQI (overall)", f"{avg_aqi:.1f}")
            st.info(f"Air Quality Category: **{classify_aqi(avg_aqi)}**")

        # Pollutant Breakdown
        pcols = [c for c in pollutant_cols if c in df_now.columns]
        if pcols:
            poll_avg = df_now[pcols].mean().reset_index()
            poll_avg.columns = ["pollutant", "aqi_value"]
            poll_avg["pollutant"] = (
                poll_avg["pollutant"].str.replace("_aqi_value", "", regex=False).str.upper()
            )

            fig = px.bar(
                poll_avg,
                x="pollutant",
                y="aqi_value",
                title="Average Pollutant-Specific AQI",
                color="pollutant",
                color_discrete_sequence=px.colors.qualitative.Set2
            )
            fig.update_layout(height=340, margin=dict(l=0, r=0, t=50, b=0))
            st.plotly_chart(fig, use_container_width=True)

        else:
            st.info("No pollutant-specific AQI values available.")

    st.markdown("</div>", unsafe_allow_html=True)

# ---------------------------------------------------------
# RIGHT — PM2.5 TIME SERIES
# ---------------------------------------------------------
with right:
    st.markdown("<div class='chart-card'>", unsafe_allow_html=True)
    st.markdown(f"### 📈 PM2.5 Historical Trend — {selected_country}")

    df_pm = df[df["country"] == selected_country][[country_col, year_col, pm25_col]].dropna()

    if df_pm.empty:
        st.info("No PM2.5 data available for this country.")
    else:
        df_pm = df_pm.sort_values(year_col)

        latest_year = df_pm[year_col].iloc[-1]
        latest_val = df_pm[pm25_col].iloc[-1]

        st.metric(f"Latest PM2.5 (μg/m³) — {latest_year}", f"{latest_val:.1f}")

        # Trend detection (linear fit)
        if len(df_pm) >= 2:
            years = df_pm[year_col].to_numpy()
            vals = df_pm[pm25_col].to_numpy()
            slope, intercept = np.polyfit(years, vals, 1)
            trend = "increasing 📈" if slope > 0 else "decreasing 📉"
            st.caption(f"Trend analysis: PM2.5 levels are **{trend}** over the recorded period.")
        else:
            st.caption("Not enough data points to calculate trend.")

        fig2 = px.line(
            df_pm,
            x=year_col,
            y=pm25_col,
            markers=True,
            title="Historical PM2.5 Levels",
            labels={year_col: "Year", pm25_col: "PM2.5 (μg/m³)"},
            color_discrete_sequence=["#2563eb"]
        )
        fig2.update_layout(height=340, margin=dict(l=0, r=0, t=50, b=0))
        st.plotly_chart(fig2, use_container_width=True)

        with st.expander("Show full PM2.5 dataset for this country"):
            st.dataframe(df_pm)

    st.markdown("</div>", unsafe_allow_html=True)

