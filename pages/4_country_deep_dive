def classify_aqi(aqi: float) -> str:
    if aqi <= 50:
        return "Good"
    elif aqi <= 100:
        return "Moderate"
    elif aqi <= 150:
        return "Unhealthy for Sensitive Groups"
    elif aqi <= 200:
        return "Unhealthy"
    elif aqi <= 300:
        return "Very Unhealthy"
    else:
        return "Hazardous"

left, right = st.columns(2)

# ----- Left: current AQI + pollutant mix + health message
with left:
    st.markdown("<div class='chart-card'>", unsafe_allow_html=True)
    st.markdown(f"#### Current Air Quality – {selected_country}")
    df_c = base_df[base_df["country"] == selected_country]

    if df_c.empty:
        st.info("No AQI data found for this country in the global air pollution dataset.")
